# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Overrides the auto-detected origin used to build the
# /check-in QR code URL shown in the admin dashboard. Set this in
# production if requests don't reliably carry Host/X-Forwarded-Proto
# headers (e.g. some proxy setups). Example: https://thecrib.example.com
NEXT_PUBLIC_SITE_URL=

# Mux — required for Phase 2 (video upload/playback). All server-only;
# never prefix with NEXT_PUBLIC_. See README "Mux setup" for where to get
# each of these from your Mux dashboard.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
