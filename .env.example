# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Overrides the auto-detected origin used to build the
# /check-in QR code URL shown in the admin dashboard. Set this in
# production if requests don't reliably carry Host/X-Forwarded-Proto
# headers (e.g. some proxy setups). Example: https://thecrib.example.com
NEXT_PUBLIC_SITE_URL=

# Mux — required for Phase 2 (video upload/playback). All server-only;
# never prefix with NEXT_PUBLIC_. See README "Mux setup" for where to get
# each of these from your Mux dashboard.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Resend — for the "your set is ready" notification email (separate from
# Supabase Auth's own SMTP-based emails). Server-only. RESEND_API_KEY can
# reuse the same API key you set as the SMTP password in Supabase's SMTP
# settings. RESEND_FROM_EMAIL must be an address on a domain verified in
# Resend, e.g. noreply@yourdomain.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry — error monitoring. NEXT_PUBLIC_SENTRY_DSN is required for error
# capture (client, server, and edge). SENTRY_ORG/SENTRY_PROJECT/
# SENTRY_AUTH_TOKEN are optional but recommended — without them, builds
# still work, but production stack traces show minified code instead of
# your actual source. See README "Sentry setup" for where to get each.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
